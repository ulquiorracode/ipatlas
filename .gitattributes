# Auto-detect text files and normalize line endings to LF on checkout
* text=auto eol=lf

# Explicit text files with LF
*.rs text eol=lf diff=rust
*.py text eol=lf diff=python
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf diff=markdown
*.txt text eol=lf
*.sh text eol=lf
*.svg text eol=lf

# Windows Batch files require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Compiled binaries and databases
*.bin binary
*.zst binary
*.gz binary
*.zip binary
*.tar.gz binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
*.pdb binary

# Media and graphical assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
